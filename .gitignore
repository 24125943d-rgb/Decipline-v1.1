# =============================================================================
# Godot 4 工程 .gitignore
# 原则：可再生的缓存 / 导入产物 / 与本机绑定的工具不入库；工程源文件全部入库。
# =============================================================================

# --- Godot 引擎缓存与导入产物（可重新生成）----------------------------------
.godot/
/android/

# --- 导出产物与导出配置 -----------------------------------------------------
# export_presets.cfg 可能含平台签名密钥与本机路径，不随仓库分发
export_presets.cfg
export.cfg
*.pck
/build/
/export/

# --- 原生模块 / GDExtension 构建产物 ---------------------------------------
*.a
*.lib
*.so
*.dylib
*.dll
*.exp
*.pdb
*.o
*.obj

# --- C# / Mono --------------------------------------------------------------
.mono/
data_*/
mono_crash.*.json

# --- 与本机绑定的编辑器工具（Ziva 智能体等）--------------------------------
# 按机器安装/自更新，且含上百 MB 二进制（zivacode.exe 130MB、git/rg 等），
# 不属于工程内容；换机器时重装即可。
addons/ziva_agent/
.ziva/

# --- 本地凭据 / 密钥（千万不要提交）----------------------------------------
.env
.env.*
*.pat
*.token
secrets.cfg

# --- IDE / 操作系统杂项 -----------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*~
*.tmp
*.swp
*.bak

# =============================================================================
# 以下文件必须提交，不要加进忽略列表：
#   project.godot        工程定义
#   *.tscn *.tres        场景与资源
#   *.gd / *.gd.uid      脚本，以及 Godot 4.4+ 的脚本 UID（删了引用会漂移）
#   *.import             导入配置（例如 icon.svg.import）
#   BlockSystem/         Git 子模块（自带 .gitignore）
# =============================================================================
